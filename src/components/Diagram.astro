---
import type { Showcase } from "../lib";
import Chess from "./dia/Chess.astro";
import Meta from "./dia/Meta.astro";
import Aleas from "./dia/Aleas.astro";
import Drone from "./dia/Drone.astro";

interface Props {
  showcase: Showcase;
}

// One animated, project-specific illustration per slide; layer N lights up at scroll step N.
const { diagram } = Astro.props.showcase;
---

{diagram === "D" && <Chess />}
{diagram === "A" && <Meta />}
{diagram === "C" && <Aleas />}
{diagram === "B" && <Drone />}

---
import { info, portfolio, NAME, REGION, CITY, url } from "../lib";
---

<div id="w-contact" class="pin pin--flow" style="--len: 1.2">
  <section id="s-contact" class="contact">
    <div class="sec-title"><span>05</span><h2 class="display">Let's chat</h2></div>
    <div class="contact__ghost" aria-hidden="true"><span class="display">{info.name}</span></div>
    <div class="contact__card card card--shadow">
      <div class="contact__cta">
        <span class="micro">{NAME} · {REGION}</span>
        <span class="display">Let's build <span class="accent">something.</span></span>
        <a href={`mailto:${info.email}`} class="btn btn--solid">SAY HELLO →</a>
      </div>
      <div class="contact__col">
        <span>SITE</span>
        <a href="#w-profile">PROFILE</a>
        <a href="#w-projects">PROJECTS</a>
        <a href="#w-experience">EXPERIENCE</a>
        <a href="#w-skills">SKILLS</a>
      </div>
      <div class="contact__col">
        <span>CONNECT</span>
        <a href={url(info.linkedin)} target="_blank" rel="noopener">LINKEDIN</a>
        <a href={url(info.github)} target="_blank" rel="noopener">GITHUB</a>
        <a href={`mailto:${info.email}`}>EMAIL</a>
      </div>
      <div class="contact__col">
        <span>FILES</span>
        <a href="/cv.pdf" download="Robin-Geral-CV.pdf">RESUME · PDF</a>
      </div>
    </div>
    <div class="contact__foot micro">
      <span><span class="blink">●</span> STATUS: ONLINE · © {portfolio.edition} {NAME}</span>
      <span>{CITY}</span>
    </div>
  </section>
</div>
